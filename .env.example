COMPOSE_PROJECT_NAME=vllm_api
COMPOSE_DOMAIN=litellm.local.itkdev.dk

HUGGING_FACE_HUB_TOKEN=

LMCACHE_L1_SIZE_GB=128

# Gemma 4
VLLM_MODEL=nvidia/Gemma-4-31B-IT-NVFP4
VLLM_OPTIONS=--quantization modelopt --tensor-parallel-size 1 --max-model-len 262144 --max-num-seqs 32 --max-num-batched-tokens 16384 --gpu-memory-utilization 0.92 --kv-cache-dtype fp8 --enable-prefix-caching --async-scheduling --kv-transfer-config '{"kv_connector":"LMCacheMPConnector","kv_role":"kv_both"}' --limit-mm-per-prompt '{"image":4,"audio":0,"video":0}' --mm-processor-kwargs '{"max_soft_tokens":560}' --mm-processor-cache-gb 16 --tool-call-parser gemma4 --enable-auto-tool-choice --reasoning-parser gemma4

SHM_SIZE=32gb

# Blackwell cu130-nightly kernel settings
VLLM_USE_DEEP_GEMM=0
VLLM_USE_FLASHINFER_MOE_FP16=0
VLLM_USE_FLASHINFER_SAMPLER=0
OMP_NUM_THREADS=4

# Leave empty if you do not wish to use API key.
VLLM_API_KEY=

POSTGRES_PASSWORD=x
REDIS_PASSWORD=

LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# Admin UI login (server variant). Keep distinct from the master key.
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=
